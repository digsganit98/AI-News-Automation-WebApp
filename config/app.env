# All URLs and non-secret settings used by the app, in one place.
# This file IS committed to git. Never put passwords or API keys here; those go in `.env`
# (see `.env.example`), which git ignores.
#
# Priority when the same name is set in several places:
#   real environment variable (e.g. GitHub Actions secret) > .env > this file
#
# Values with {placeholders} are templates the code fills in, e.g. {id} or {channelId}.

# --- Identity sent with every HTTP request ---
PROJECT_URL=https://github.com/digsganit98/AI-News-Automation-WebApp
USER_AGENT=genai-digest/0.1 (+https://github.com/digsganit98/AI-News-Automation-WebApp)

# --- Website (GitHub Pages) ---
SITE_URL=https://digsganit98.github.io
SITE_BASE_PATH=/AI-News-Automation-WebApp
# Inter: the closest free match to Apple's SF Pro, for non-Apple devices
WEB_FONT_CSS_URL=https://fonts.googleapis.com/css2?family=Inter:wght@400..800&display=swap
WEB_FONT_ORIGIN_URL=https://fonts.gstatic.com

# --- Digest ---
DIGEST_TIMEZONE=Asia/Kolkata
ARTICLE_MAX_BYTES=2000000
ARTICLE_MAX_CHARS=8000
HOST_REQUEST_SPACING_SECONDS=2

# --- AI labs and research blogs ---
OPENAI_FEED_URL=https://openai.com/news/rss.xml
DEEPMIND_FEED_URL=https://deepmind.google/blog/rss.xml
HUGGINGFACE_FEED_URL=https://huggingface.co/blog/feed.xml
BAIR_FEED_URL=https://bair.berkeley.edu/blog/feed.xml
ANTHROPIC_NEWS_URL=https://www.anthropic.com/news
MISTRAL_FEED_URL=https://mistral.ai/news/rss
MICROSOFT_RESEARCH_FEED_URL=https://www.microsoft.com/en-us/research/feed/

# --- Hugging Face (new open models and papers) ---
HF_TRENDING_MODELS_API_URL=https://huggingface.co/api/models
HF_MODEL_URL=https://huggingface.co/{id}
HF_DAILY_PAPERS_API_URL=https://huggingface.co/api/daily_papers
HF_PAPER_URL=https://huggingface.co/papers/{id}
ARXIV_ABS_URL=https://arxiv.org/abs/{id}

# --- Hacker News ---
HN_ALGOLIA_URL=https://hn.algolia.com/api/v1/search_by_date
HN_ALGOLIA_SEARCH_URL=https://hn.algolia.com/api/v1/search
HN_ITEM_URL=https://news.ycombinator.com/item?id={id}
HN_FRONTPAGE_RSS_URL=https://news.ycombinator.com/rss

# --- Reddit ---
# Several subreddits in one request (a+b+c) keeps us under Reddit's rate limit.
REDDIT_AI_FEED_URL=https://www.reddit.com/r/LocalLLaMA+MachineLearning+singularity/top/.rss?t=day

# --- YouTube ---
YOUTUBE_FEED_URL=https://www.youtube.com/feeds/videos.xml?channel_id={channelId}
YOUTUBE_API_URL=https://www.googleapis.com/youtube/v3/playlistItems
YOUTUBE_VIDEO_URL=https://www.youtube.com/watch?v={videoId}

# --- Architecture diagram logos (scripts/buildArchitectureDiagram.py) ---
SIMPLE_ICONS_ICON_URL=https://cdn.jsdelivr.net/npm/simple-icons@16.32.0/icons/{slug}.svg
SIMPLE_ICONS_DATA_URL=https://cdn.jsdelivr.net/npm/simple-icons@16.32.0/data/simple-icons.json
# Logos removed from Simple Icons v16 (e.g. OpenAI) come from the last version that had them.
SIMPLE_ICONS_LEGACY_ICON_URL=https://cdn.jsdelivr.net/npm/simple-icons@15.14.0/icons/{slug}.svg

# --- Newsletter inbox (Gmail) ---
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
