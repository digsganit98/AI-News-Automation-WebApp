---
// The daily edition as a card deck: one short opinion take per card (swipe, arrow keys or
// buttons), then "You're all caught up". No story cards: browsing the news is Latest's job.
import { digestCards, formatDay, href, type DigestFile } from "../lib/siteData";

interface Props {
  edition: DigestFile;
}

const { edition } = Astro.props;
const { digest, stories } = edition;
const TONES = [
  { text: "text-[#0058b0] dark:text-[#6fb0ff]", bg: "bg-[#0071e3] dark:bg-[#2997ff]", soft: "bg-[#0071e3]/[0.07] dark:bg-[#2997ff]/10", bar: "border-[#0071e3] dark:border-[#2997ff]" },
  { text: "text-[#8944ab] dark:text-[#bf5af2]", bg: "bg-[#8944ab] dark:bg-[#bf5af2]", soft: "bg-[#8944ab]/[0.07] dark:bg-[#bf5af2]/10", bar: "border-[#8944ab] dark:border-[#bf5af2]" },
  { text: "text-[#0c817b] dark:text-[#66d4cf]", bg: "bg-[#00c7be] dark:bg-[#66d4cf]", soft: "bg-[#00c7be]/[0.09] dark:bg-[#66d4cf]/10", bar: "border-[#00c7be] dark:border-[#66d4cf]" },
];
const cards = digestCards(edition).map((card, i) => ({ ...card, tone: TONES[i % TONES.length] }));
const total = cards.length + 1; // + the "all caught up" card
const count = ["No", "One", "Two", "Three"][cards.length] ?? String(cards.length);
const minutes = Math.max(1, Math.round(cards.flatMap((c) => [c.whatHappened, c.take, c.watchFor, ...(c.paragraphs ?? [])]).join(" ").split(/\s+/).length / 200));

// "Also today": the day's top stories that no take covered, as plain links (not story cards).
const covered = new Set(cards.flatMap((c) => c.basedOn.map((s) => s.id)));
const alsoToday = digest.topStoryIds.map((id) => stories[id]).filter((s) => s && !covered.has(s.id)).slice(0, 4);
---

<header class="mx-auto max-w-3xl text-center">
  <p class="eyebrow mb-3 !text-[#bf5af2]">Daily Digest · {formatDay(edition.date)}</p>
  <h1 class="headline text-4xl leading-[1.08] sm:text-6xl">Today's briefing.</h1>
  <p class="mt-3 text-base sm:text-lg font-medium text-slate-900 dark:text-slate-100">
    {count} {cards.length === 1 ? "take" : "takes"} · {minutes} {minutes === 1 ? "minute" : "minutes"} · AI-written opinion, fact-checked
  </p>
</header>

<section class="mx-auto mt-10 max-w-3xl" data-deck aria-roledescription="carousel" aria-label="Today's takes">
  <div class="mb-4 flex gap-2">
    {Array.from({ length: total }).map((_, i) => (
      <button type="button" data-go={i} class="group h-4 flex-1 cursor-pointer" aria-label={i < cards.length ? `Go to take ${i + 1}` : "Go to the last card"}>
        <span class="block h-1 overflow-hidden rounded-full bg-black/10 transition group-hover:bg-black/20 dark:bg-white/15 dark:group-hover:bg-white/25">
          <span data-bar={i} class={`block h-full rounded-full bg-ink transition-[width] duration-300 dark:bg-white ${i === 0 ? "w-full" : "w-0"}`}></span>
        </span>
      </button>
    ))}
  </div>

  <div aria-live="polite">
    {cards.map((card, i) => (
      <article data-card={i} class="card p-8 sm:p-12">
        <p class={`flex items-center gap-2 text-[13px] font-semibold uppercase tracking-[0.08em] ${card.tone.text}`}>
          <span class={`size-2 rounded-full ${card.tone.bg}`}></span>{card.theme}
          <span class="ml-auto text-xs font-semibold normal-case tracking-normal text-slate-800 dark:text-slate-200">{i + 1} of {cards.length}</span>
        </p>
        <h2 class="mt-4 text-3xl font-semibold leading-tight tracking-[-0.03em] sm:text-[40px]">{card.title}</h2>
        <p class={`mt-4 rounded-xl border-l-4 px-4 py-2.5 text-base sm:text-lg font-semibold leading-snug tracking-[-0.015em] ${card.tone.soft} ${card.tone.bar}`}>“{card.verdict}”</p>
        <div class="mt-5 space-y-4 text-base leading-relaxed text-slate-900 dark:text-slate-100">
          {card.whatHappened && <p><span class="eyebrow mr-2 !text-[11px] font-bold text-slate-900">What happened</span><span class="text-slate-900 dark:text-slate-100">{card.whatHappened}</span></p>}
          {card.take && <p><span class={`eyebrow mr-2 !text-[11px] font-bold ${card.tone.text}`}>Our take</span><span class="text-slate-900 font-medium dark:text-slate-100">{card.take}</span></p>}
          {card.watchFor && <p><span class="eyebrow mr-2 !text-[11px] font-bold text-slate-900">Watch for</span><span class="text-slate-900 dark:text-slate-100">{card.watchFor}</span></p>}
          {card.paragraphs?.map((p) => <p class="text-slate-900 dark:text-slate-100">{p}</p>)}
        </div>
        {card.basedOn.length > 0 && (
          <p class="mt-7 flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-black/[0.06] pt-5 text-sm dark:border-white/10">
            <span class="text-xs font-bold uppercase tracking-[0.08em] text-slate-800 dark:text-slate-200">Based on</span>
            {card.basedOn.map((story) => (
              <a href={story.sources[0]?.url} target="_blank" rel="noopener" class="font-medium text-brand-600 hover:underline dark:text-brand-400">{story.headline} ↗</a>
            ))}
          </p>
        )}
      </article>
    ))}

    <article data-card={cards.length} class="card p-8 text-center sm:p-12">
      <span class="mx-auto grid size-14 place-items-center rounded-full bg-emerald-500 text-white">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
      </span>
      <h2 class="mt-5 text-4xl font-semibold tracking-[-0.03em]">You're all caught up.</h2>
      <p class="mt-2 text-base font-medium text-slate-800 dark:text-slate-200">The next briefing arrives tomorrow by 09:30 IST.</p>
      {alsoToday.length > 0 && (
        <div class="mx-auto mt-8 max-w-xl text-left">
          <h3 class="eyebrow mb-3 !text-[11px] font-bold text-slate-900">Also in today's news</h3>
          <ul class="space-y-2.5 text-[16px]">
            {alsoToday.map((story) => (
              <li class="flex gap-3">
                <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-brand-500"></span>
                <a href={story.sources[0]?.url} target="_blank" rel="noopener" class="font-medium text-slate-900 hover:text-brand-600 dark:text-slate-100 dark:hover:text-brand-400">{story.headline} ↗</a>
              </li>
            ))}
          </ul>
        </div>
      )}
      <div class="mt-8 flex flex-wrap justify-center gap-2">
        <a href={href("")} class="glass-button !py-2">All of today's news</a>
        <a href={href("papers")} class="chip">New papers</a>
      </div>
    </article>
  </div>

  <div class="mt-5 flex items-center justify-between gap-3">
    <button type="button" data-step="-1" class="chip" aria-label="Previous card">← Back</button>
    <p class="hidden text-sm font-semibold text-slate-700 sm:block dark:text-slate-300">Swipe, or use the ← → keys</p>
    <button type="button" data-step="1" class="glass-button !py-2" aria-label="Next card"><span data-next-label>Next take</span> →</button>
  </div>
  <p class="mt-6 text-center text-xs font-medium text-slate-700 dark:text-slate-400">
    Written by the Writer agent and fact-checked by the Editor agent against the original articles. Opinions are the AI's, not a person's.
  </p>
</section>

<script is:inline>
  // One card at a time. Without JavaScript every card simply shows, one under the other.
  document.querySelectorAll("[data-deck]").forEach((deck) => {
    const cards = [...deck.querySelectorAll("[data-card]")];
    const back = deck.querySelector('[data-step="-1"]');
    const next = deck.querySelector('[data-step="1"]');
    const label = deck.querySelector("[data-next-label]");
    const last = cards.length - 1;
    let at = 0;
    const show = (n) => {
      at = Math.max(0, Math.min(last, n));
      cards.forEach((el, i) => el.classList.toggle("hidden", i !== at));
      deck.querySelectorAll("[data-bar]").forEach((el) => { el.style.width = Number(el.dataset.bar) <= at ? "100%" : "0%"; });
      back.style.visibility = at === 0 ? "hidden" : "visible";
      next.style.visibility = at === last ? "hidden" : "visible";
      label.textContent = at === last - 1 ? "Finish" : "Next take";
    };
    deck.querySelectorAll("[data-step]").forEach((b) => b.addEventListener("click", () => show(at + Number(b.dataset.step))));
    deck.querySelectorAll("[data-go]").forEach((b) => b.addEventListener("click", () => show(Number(b.dataset.go))));
    document.addEventListener("keydown", (e) => {
      if (e.target instanceof HTMLElement && e.target.closest("input, textarea, select")) return;
      if (e.key === "ArrowRight") show(at + 1);
      if (e.key === "ArrowLeft") show(at - 1);
    });
    let startX = null;
    deck.addEventListener("touchstart", (e) => { startX = e.touches[0].clientX; }, { passive: true });
    deck.addEventListener("touchend", (e) => {
      if (startX === null) return;
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(at + (dx < 0 ? 1 : -1));
      startX = null;
    });
    // A link can open a given card: #card-2 (the second take), #card-4 (the last card).
    const linked = Number(location.hash.match(/^#card-(\d+)$/)?.[1] ?? 1);
    show(linked - 1);
  });
</script>
