---
// One analyst story: headline, plain-language summary, why it matters, every source,
// and "Go deeper" links (paper, code, model, demo) when the agents found them.
import { CATEGORY_STYLE, IMPORTANCE_LABEL, type Story } from "../lib/siteData";

interface Props {
  story: Story;
  large?: boolean;
}

const { story, large = false } = Astro.props;
const deeper = Object.entries(story.goDeeper ?? {}).filter(([, url]) => url) as [string, string][];
const deeperLabel: Record<string, string> = { paper: "Paper", code: "Code", model: "Model", demo: "Demo" };
---

<article class={`card flex flex-col ${large ? "p-7" : "p-5"}`}>
  <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-semibold">
    <span class={CATEGORY_STYLE[story.category] ?? "text-slate-900 font-bold"}>{story.category}</span>
    <span class="flex items-center gap-1 text-slate-800 font-semibold" title={`Importance ${story.importance} of 5`}>
      <span aria-hidden="true" class="tracking-[0.15em] text-[#1a00d9]">{"●".repeat(story.importance)}<span class="opacity-25 text-slate-400">{"●".repeat(5 - story.importance)}</span></span>
      {IMPORTANCE_LABEL[story.importance]}
    </span>
    {story.sourceType && <span class="text-slate-800 font-medium">· {story.sourceType}</span>}
    {story.status === "followUp" && <span class="pill border-amber-300 bg-amber-100 text-amber-900 font-bold">Update</span>}
  </div>
  <h3 class={`font-bold leading-snug tracking-[-0.02em] text-slate-950 ${large ? "text-2xl" : "text-[17px]"}`}>
    <a href={story.sources[0]?.url} target="_blank" rel="noopener" class="hover:text-brand-600 dark:hover:text-brand-400">{story.headline}</a>
  </h3>
  <p class={`mt-2 leading-relaxed text-slate-900 font-normal ${large ? "text-base" : "text-sm"}`}>{story.summary}</p>
  {(story.cloudPlatform || story.industryVertical) && (
    <p class="mt-2.5 flex flex-wrap gap-1.5 text-[11px] font-semibold">
      {story.cloudPlatform && <span class="pill border-slate-300 bg-slate-100 text-slate-900">{story.cloudPlatform}</span>}
      {story.industryVertical && <span class="pill border-slate-300 bg-slate-100 text-slate-900">{story.industryVertical}</span>}
    </p>
  )}
  {story.whyItMatters && (
    <div class="mt-3.5 rounded-xl border border-blue-200 bg-blue-50/80 p-3 text-xs sm:text-sm text-slate-900 leading-relaxed shadow-2xs">
      <span class="font-bold text-[#1a00d9]">Why it matters:</span> {story.whyItMatters}
    </div>
  )}
  <div class="mt-auto flex flex-wrap items-center gap-2 pt-4 text-xs font-medium">
    {story.sources.map((s) => (
      <a href={s.url} target="_blank" rel="noopener" class="pill border-slate-300 bg-slate-100 text-slate-900 hover:border-brand-400 hover:text-brand-600 transition">{s.name}</a>
    ))}
    {deeper.length > 0 && (
      <span class="ml-auto flex gap-3 font-bold">
        {deeper.map(([kind, url]) => (
          <a href={url} target="_blank" rel="noopener" class="text-brand-600 hover:underline dark:text-brand-400">{deeperLabel[kind] ?? kind} ↗</a>
        ))}
      </span>
    )}
  </div>
</article>
