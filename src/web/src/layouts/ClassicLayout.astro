---
// Original Apple-inspired liquid glass layout with dark mode toggle and GenAI Daily branding.
import "../styles/classic.css";
import { href, projectUrl } from "../lib/siteData";

interface Props {
  title: string;
  description?: string;
  current: "home" | "digest" | "ideas" | "papers" | "sources" | "about" | "archive";
  showFooter?: boolean;
}

const {
  title,
  description = "Today in generative AI: what labs, platforms and developers released or discussed.",
  current,
  showFooter = true,
} = Astro.props;

const author = "GenAI Team";
const nav = [
  { id: "home", label: "Latest News", page: "classic" },
  { id: "digest", label: "Daily Digest", page: "digest" },
  { id: "papers", label: "Paper Trail", page: "papers" },
  { id: "sources", label: "Sources", page: "sources" },
  { id: "about", label: "How It Works", page: "about" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · GenAI Daily</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={href("favicon.svg")} />
    <script is:inline>
      try {
        const saved = localStorage.getItem("theme");
        const dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      } catch {}
      if (navigator.userAgentData?.brands?.some((b) => /Chromium/.test(b.brand))) {
        document.documentElement.classList.add("refraction");
      }
    </script>
  </head>
  <body class="min-h-screen font-sans">
    <!-- Pastel wallpaper behind the glass -->
    <div class="glass-backdrop" aria-hidden="true">
      <span class="-left-40 -top-40 size-[640px] bg-[#7cb8ff] dark:bg-[#0a3d91]"></span>
      <span class="right-[-180px] top-[8%] size-[560px] bg-[#d6b4ff] dark:bg-[#4b1d8a]"></span>
      <span class="bottom-[-220px] left-[18%] size-[620px] bg-[#ffc9a8] dark:bg-[#5b1f6e]"></span>
      <span class="bottom-[10%] right-[12%] size-[420px] bg-[#9ff0e0] dark:bg-[#0b4a5e]"></span>
    </div>

    <!-- Displacement map for the liquid refraction -->
    <svg width="0" height="0" class="absolute" aria-hidden="true">
      <filter id="liquidGlass" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.008 0.012" numOctaves="2" seed="7" result="noise"></feTurbulence>
        <feGaussianBlur in="noise" stdDeviation="2" result="softNoise"></feGaussianBlur>
        <feDisplacementMap in="SourceGraphic" in2="softNoise" scale="38" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
      </filter>
    </svg>

    <header class="sticky top-0 z-30 px-3 pt-3 sm:px-6">
      <div class="glass-nav mx-auto flex max-w-6xl items-center gap-2 py-1.5 pl-2 pr-1.5">
        <a href={href("classic")} class="flex items-center gap-2.5 rounded-full py-1 pl-1 pr-3 font-semibold">
          <span class="grid size-8 place-items-center rounded-full bg-gradient-to-b from-[#2997ff] to-[#0062d1] text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.6),0_4px_12px_-3px_rgba(0,113,227,0.7)]">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M12 2l2.2 6.3L20.5 10l-6.3 2.2L12 18.5l-2.2-6.3L3.5 10l6.3-1.7z"></path><path d="M19 15l.9 2.4 2.4.9-2.4.9-.9 2.4-.9-2.4-2.4-.9 2.4-.9z" opacity=".7"></path></svg>
          </span>
          <span class="text-[17px] tracking-[-0.02em]">GenAI Daily</span>
        </a>
        <nav class="mx-auto hidden items-center gap-0.5 md:flex" aria-label="Main">
          {nav.map((n) => (
            <a class="nav-link" href={href(n.page)} aria-current={n.id === current ? "page" : undefined}>{n.label}</a>
          ))}
        </nav>
        <div class="ml-auto flex items-center gap-1 md:ml-0">
          <!-- Switch to Ganit Link -->
          <a
            href={href("ganit")}
            class="inline-flex items-center gap-1 rounded-full border border-blue-400/40 bg-[#1a00d9]/10 px-3 py-1 text-xs font-semibold text-[#1a00d9] dark:bg-[#1a00d9]/25 dark:text-blue-300 transition hover:scale-105"
            title="Switch to Ganit Enterprise Design"
          >
            Ganit Design ↗
          </a>
          <a class="nav-link grid size-9 place-items-center !px-0" href={href("archive")} aria-label="Archive" title="Archive">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4.5" width="18" height="16" rx="3"></rect><path d="M3 9.5h18M8 2.5v4M16 2.5v4M7.5 13.5h2M11 13.5h2M14.5 13.5h2M7.5 17h2M11 17h2"></path></svg>
          </a>
          <button id="themeToggleClassic" class="nav-link grid size-9 place-items-center !px-0" type="button" aria-label="Toggle theme">
            <svg class="hidden dark:block" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
            <svg class="block dark:hidden" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
          </button>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 pt-8 pb-16 sm:px-6">
      <slot />
    </main>

    {showFooter && (
    <footer class="mx-auto max-w-6xl px-4 pb-10 sm:px-6">
      <div class="flex items-center justify-center gap-2 border-t border-black/[0.06] pt-6 text-[13px] text-ink-muted dark:border-white/10 dark:text-[#a1a1a6]">
        <p>Built with <span class="text-[#ff2d55]">♥</span> by <span class="font-medium text-ink dark:text-white">{author}</span></p>
      </div>
    </footer>
    )}

    <script is:inline>
      document.getElementById("themeToggleClassic")?.addEventListener("click", () => {
        const dark = document.documentElement.classList.toggle("dark");
        try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch {}
      });
      document.addEventListener("pointermove", (e) => {
        const el = e.target instanceof Element ? e.target.closest(".glass, .card, .chip, .field") : null;
        if (!el) return;
        const r = el.getBoundingClientRect();
        const k = r.width ? el.offsetWidth / r.width : 1;
        el.style.setProperty("--mx", `${(e.clientX - r.left) * k}px`);
        el.style.setProperty("--my", `${(e.clientY - r.top) * k}px`);
      }, { passive: true });
    </script>
  </body>
</html>
