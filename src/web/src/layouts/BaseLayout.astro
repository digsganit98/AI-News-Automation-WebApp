---
// Clean white layout with Ganit Inc branding, original ambient pastel background, symmetric width matching, and bottom blue strip.
import "../styles/global.css";
import { href } from "../lib/siteData";

interface Props {
  title: string;
  description?: string;
  current: "home" | "digest" | "ideas" | "papers" | "sources" | "about" | "archive";
  showFooter?: boolean;
}

const {
  title,
  description = "Ganit GenAI Hub: Tracking cutting-edge models, architectures, and ideas for builders.",
  current,
  showFooter = true,
} = Astro.props;

// Compact main navigation
const nav = [
  { id: "home", label: "Latest", page: "" },
  { id: "ideas", label: "R&D Ideas", page: "ideas" },
  { id: "digest", label: "Daily Digest", page: "digest" },
  { id: "papers", label: "Paper Trail", page: "papers" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Ganit GenAI</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={href("ganit-icon.png")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      // Strictly enforce white mode and clear any legacy dark mode keys
      document.documentElement.classList.remove("dark");
      try { localStorage.removeItem("theme"); } catch {}
    </script>
  </head>
  <body class="min-h-screen text-slate-900 antialiased font-sans flex flex-col justify-between">
    <!-- Original Ganit white mode ambient pastel backdrop with dot grid -->
    <div class="glass-backdrop" aria-hidden="true">
      <span class="-left-40 -top-40 size-[600px] bg-[#1a00d9]"></span>
      <span class="right-[-120px] top-[15%] size-[500px] bg-[#fe6e06]"></span>
      <span class="bottom-[-180px] left-[25%] size-[550px] bg-[#1a00d9]"></span>
    </div>

    <div>
      <!-- Top bar matches exact same max-w-6xl width as content cards -->
      <div class="sticky top-3 z-40 mx-auto max-w-6xl px-4 sm:px-6">
        <header class="flex items-center justify-between rounded-2xl border border-slate-200/90 bg-white/95 px-5 py-3.5 shadow-sm backdrop-blur-xs sm:py-4">
          <!-- Ganit image bigger and zoomed in with slight rounded corners -->
          <a href={href("")} class="flex items-center no-underline" title="Ganit Home">
            <img
              src={href("ganit-logo-clean.png")}
              alt="Ganit"
              class="h-9 w-auto rounded-md object-contain sm:h-10"
            />
          </a>

          <!-- Main Navigation (compact, clean, comfortably sized) -->
          <nav class="flex items-center gap-1.5" aria-label="Main">
            {nav.map((n) => (
              <a
                class={`rounded-lg px-3.5 py-2 text-xs font-semibold transition sm:text-sm ${
                  n.id === current
                    ? "bg-slate-100 text-[#1a00d9]"
                    : "text-slate-600 hover:bg-slate-50 hover:text-slate-900"
                }`}
                href={href(n.page)}
                aria-current={n.id === current ? "page" : undefined}
              >
                {n.label}
              </a>
            ))}
          </nav>

          <!-- Right utility buttons: Archive, Settings/About -->
          <div class="flex items-center gap-1.5 text-slate-500">
            <a
              class="grid size-9 place-items-center rounded-lg hover:bg-slate-100 hover:text-slate-900 transition"
              href={href("archive")}
              aria-label="Archive"
              title="News Archive"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <rect x="3" y="4.5" width="18" height="16" rx="3"></rect>
                <path d="M3 9.5h18M8 2.5v4M16 2.5v4M7.5 13.5h2M11 13.5h2M14.5 13.5h2M7.5 17h2M11 17h2"></path>
              </svg>
            </a>

            <a
              class="grid size-9 place-items-center rounded-lg hover:bg-slate-100 hover:text-slate-900 transition"
              href={href("about")}
              aria-label="How It Works & Settings"
              title="How It Works & Settings"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 16v-4M12 8h.01"></path>
              </svg>
            </a>
          </div>
        </header>
      </div>

      <!-- Main Content (exact same max-w-6xl width) -->
      <main class="mx-auto max-w-6xl px-4 py-6 sm:px-6">
        <slot />
      </main>
    </div>

    <!-- Clean 1-line Footer with Ganit Electric Blue Accent Strip at bottom -->
    {showFooter && (
      <div>
        <footer class="mx-auto max-w-6xl px-4 py-6 sm:px-6">
          <div class="flex flex-col items-center justify-between gap-3 border-t border-slate-200 pt-4 text-xs text-slate-500 sm:flex-row">
            <div>
              <span>© 2026 Ganit Inc. · Data Speaks</span>
            </div>
            <div class="flex items-center gap-4">
              <a href={href("sources")} class="hover:text-slate-900">Sources</a>
              <a href={href("about")} class="hover:text-slate-900">How It Works</a>
              <a href="https://ganitinc.com" target="_blank" rel="noopener" class="hover:text-slate-900">ganitinc.com ↗</a>
              <a href="https://www.linkedin.com/company/ganit-inc/" target="_blank" rel="noopener" class="hover:text-slate-900">LinkedIn ↗</a>
            </div>
          </div>
        </footer>
        <!-- Ganit Electric Blue Bottom Strip -->
        <div class="h-1.5 w-full bg-[#1a00d9]"></div>
      </div>
    )}
  </body>
</html>
