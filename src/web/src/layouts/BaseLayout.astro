---
// Shared page frame, Apple "Liquid Glass" style: pastel wallpaper, floating glass
// capsule navigation, theme toggle and the sign-off footer (Latest and Archive).
import "../styles/global.css";
import { href, projectUrl } from "../lib/siteData";

interface Props {
  title: string;
  description?: string;
  current: "home" | "digest" | "papers" | "sources" | "about" | "archive";
  showFooter?: boolean; // the "Built with ♥" sign-off: Latest and Archive only
}

const { title, description = "The latest Generative AI news from 30 sources, updated every 3 hours.", current, showFooter = false } = Astro.props;
const author = process.env.SITE_AUTHOR;
const fontCssUrl = process.env.WEB_FONT_CSS_URL;
const fontOriginUrl = process.env.WEB_FONT_ORIGIN_URL;
const nav = [
  { id: "home", label: "Latest", page: "" },
  { id: "digest", label: "Daily Digest", page: "digest" },
  { id: "papers", label: "Paper Trail", page: "papers" },
  { id: "sources", label: "Sources", page: "sources" },
  { id: "about", label: "How it works", page: "about" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · GenAI Daily</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} · GenAI Daily`} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={href("favicon.svg")} />
    {fontOriginUrl && <link rel="preconnect" href={fontOriginUrl} crossorigin />}
    {fontCssUrl && <link rel="stylesheet" href={fontCssUrl} />}
    <script is:inline>
      // Apply the saved theme before the page paints, to avoid a flash.
      try {
        const saved = localStorage.getItem("theme");
        const dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      } catch {}
      // Real glass refraction needs SVG backdrop filters, which only Chromium renders.
      if (navigator.userAgentData?.brands?.some((b) => /Chromium/.test(b.brand))) {
        document.documentElement.classList.add("refraction");
      }
    </script>
  </head>
  <body class="min-h-screen font-sans">
    <!-- Pastel wallpaper behind the glass (like iOS 26 / macOS 26). -->
    <div class="glass-backdrop" aria-hidden="true">
      <span class="-left-40 -top-40 size-[640px] bg-[#7cb8ff] dark:bg-[#0a3d91]"></span>
      <span class="right-[-180px] top-[8%] size-[560px] bg-[#d6b4ff] dark:bg-[#4b1d8a]"></span>
      <span class="bottom-[-220px] left-[18%] size-[620px] bg-[#ffc9a8] dark:bg-[#5b1f6e]"></span>
      <span class="bottom-[10%] right-[12%] size-[420px] bg-[#9ff0e0] dark:bg-[#0b4a5e]"></span>
    </div>

    <!-- Displacement map for the liquid refraction of the navigation capsule. -->
    <svg width="0" height="0" class="absolute" aria-hidden="true">
      <filter id="liquidGlass" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.008 0.012" numOctaves="2" seed="7" result="noise"></feTurbulence>
        <feGaussianBlur in="noise" stdDeviation="2" result="softNoise"></feGaussianBlur>
        <feDisplacementMap in="SourceGraphic" in2="softNoise" scale="38" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
      </filter>
    </svg>

    <header class="sticky top-0 z-30 px-3 pt-3 sm:px-6">
      <div class="glass-nav mx-auto flex max-w-6xl items-center gap-2 py-1.5 pl-2 pr-1.5">
        <a href={href("")} class="flex items-center gap-2.5 rounded-full py-1 pl-1 pr-3 font-semibold">
          <span class="grid size-8 place-items-center rounded-full bg-gradient-to-b from-[#2997ff] to-[#0062d1] text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.6),0_4px_12px_-3px_rgba(0,113,227,0.7)]">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M12 2l2.2 6.3L20.5 10l-6.3 2.2L12 18.5l-2.2-6.3L3.5 10l6.3-1.7z"></path><path d="M19 15l.9 2.4 2.4.9-2.4.9-.9 2.4-.9-2.4-2.4-.9 2.4-.9z" opacity=".7"></path></svg>
          </span>
          <span class="text-[17px] tracking-[-0.02em]">GenAI Daily</span>
        </a>
        <nav class="mx-auto hidden items-center gap-0.5 md:flex" aria-label="Main">
          {nav.map((n) => (
            <a class="nav-link" href={href(n.page)} aria-current={n.id === current ? "page" : undefined}>{n.label}</a>
          ))}
        </nav>
        <div class="ml-auto flex items-center gap-0.5 md:ml-0">
          <a class="nav-link grid size-9 place-items-center !px-0" href={href("archive")} aria-label="Archive: last 5 days" title="Archive: last 5 days" aria-current={current === "archive" ? "page" : undefined}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4.5" width="18" height="16" rx="3"></rect><path d="M3 9.5h18M8 2.5v4M16 2.5v4M7.5 13.5h2M11 13.5h2M14.5 13.5h2M7.5 17h2M11 17h2"></path></svg>
          </a>
          <a class="nav-link grid size-9 place-items-center !px-0" href={projectUrl} target="_blank" rel="noopener" aria-label="Source code on GitHub">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.1 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"></path></svg>
          </a>
          <button id="themeToggle" class="nav-link grid size-9 place-items-center !px-0" type="button" aria-label="Switch light or dark theme">
            <svg class="hidden dark:block" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
            <svg class="block dark:hidden" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
          </button>
        </div>
      </div>
      <nav class="glass-nav mx-auto mt-2 flex max-w-fit gap-0.5 overflow-x-auto p-1 md:hidden" aria-label="Main (mobile)">
        {nav.map((n) => (
          <a class="nav-link whitespace-nowrap" href={href(n.page)} aria-current={n.id === current ? "page" : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>

    <main class="mx-auto max-w-6xl px-4 pt-12 pb-16 sm:px-6">
      <slot />
    </main>

    {showFooter && (
    <footer class="mx-auto max-w-6xl px-4 pb-10 sm:px-6">
      <div class="flex items-center justify-center gap-2 border-t border-black/[0.06] pt-6 text-[13px] text-ink-muted dark:border-white/10 dark:text-[#a1a1a6]">
        <p>
          Built with <span class="text-[#ff2d55] dark:text-[#ff375f]" aria-label="love">♥</span> and way too much <span aria-label="coffee">☕</span>
          {author && <>by <span class="font-medium text-ink dark:text-white">{author}</span></>}
        </p>
        <a class="grid size-7 place-items-center rounded-full transition hover:bg-black/5 hover:text-ink dark:hover:bg-white/10 dark:hover:text-white" href={projectUrl} target="_blank" rel="noopener" aria-label="Source code on GitHub" title="Source code on GitHub">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.1 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"></path></svg>
        </a>
      </div>
    </footer>
    )}

    <script is:inline>
      document.getElementById("themeToggle")?.addEventListener("click", () => {
        const dark = document.documentElement.classList.toggle("dark");
        try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch {}
      });
      // Specular highlight: tell the glass under the pointer where the light is.
      document.addEventListener("pointermove", (e) => {
        const el = e.target instanceof Element ? e.target.closest(".glass, .card, .chip, .field") : null;
        if (!el) return;
        const r = el.getBoundingClientRect();
        const k = r.width ? el.offsetWidth / r.width : 1; // 1, or 1/0.75 inside .edition-scale
        el.style.setProperty("--mx", `${(e.clientX - r.left) * k}px`);
        el.style.setProperty("--my", `${(e.clientY - r.top) * k}px`);
      }, { passive: true });
    </script>
  </body>
</html>
