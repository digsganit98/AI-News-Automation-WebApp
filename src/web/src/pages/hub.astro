---
// GenAI R&D Hub: articles written by our own teams. Uploading is a small button, not the page.
import HubArticles from "../components/HubArticles";
import type { HubCard } from "../lib/hubTypes";
import BaseLayout from "../layouts/BaseLayout.astro";
import { href, loadHubArticles } from "../lib/siteData";

const articles = loadHubArticles();
const cards: HubCard[] = articles.map((a) => ({
  id: a.id, title: a.title, summary: a.summary, author: a.author, team: a.team, tags: a.tags,
  format: a.format, techDomain: a.techDomain ?? "Other", cloudPlatform: a.cloudPlatform ?? "Other",
  industryVertical: a.industryVertical ?? "Cross-industry", url: href(`hub/${a.file}`), publishedAt: a.publishedAt,
}));
const teams = new Set(articles.map((a) => a.team)).size;
const authors = new Set(articles.map((a) => a.author)).size;
// SharePoint is the only upload route; fall back to the old upload / project URLs if it is not set.
const sharePointUrl = process.env.HUB_SHAREPOINT_URL ?? process.env.HUB_UPLOAD_URL ?? process.env.PROJECT_URL ?? "";
---

<BaseLayout title="R&D Hub" current="hub" description="Experiments, findings and lessons written by our own GenAI teams.">
  {/* Hero: one-line headline (54px on sm+, the old 72px reduced by 25%) and two equal stat tiles. */}
  <section class="mb-6 mt-2 flex flex-wrap items-center justify-between gap-5">
    <h1 class="headline text-center text-4xl leading-[1.05] sm:text-left sm:text-[54px] md:whitespace-nowrap">GenAI R&amp;D Hub.</h1>
    <aside class="grid w-full max-w-[500px] shrink-0 grid-cols-2 gap-2.5" aria-label="At a glance">
      <div class="card kpi kpi-tint flex h-[52px] items-center justify-between gap-3 px-[18px] [--t:#0a84ff]">
        <div class="leading-tight"><p class="eyebrow !text-[10px]">Articles</p><p class="text-[11px] text-slate-500 dark:text-slate-400">from {teams} {teams === 1 ? "team" : "teams"}</p></div>
        <p class="text-xl font-bold tracking-[-0.03em]">{articles.length}</p>
      </div>
      <div class="card kpi kpi-tint flex h-[52px] items-center justify-between gap-3 px-[18px] [--t:#ff375f]">
        <div class="leading-tight"><p class="eyebrow !text-[10px]">Contributors</p></div>
        <p class="text-xl font-bold tracking-[-0.03em]">{authors}</p>
      </div>
    </aside>
  </section>

  <HubArticles client:load articles={cards} sharePointUrl={sharePointUrl} />
</BaseLayout>
