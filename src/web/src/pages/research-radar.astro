---
// Research Radar: every new GenAI development from the last 3 days, one row each, in the
// research strategy's exact columns, with a CSV download.
import BaseLayout from "../layouts/BaseLayout.astro";
import { LOG_COLUMNS, href, loadLogEntries } from "../lib/siteData";

const RADAR_DAYS = 3;
const entries = loadLogEntries(RADAR_DAYS);
const reviewed = entries.filter((e) => e.reviewed).length;
const linkIndex = LOG_COLUMNS.indexOf("Link");
const summaryIndex = LOG_COLUMNS.indexOf("Summary");
const topicIndex = LOG_COLUMNS.indexOf("Idea / Topic");
---

<BaseLayout title="Research Radar" current="log" description="Every new GenAI development from the last 3 days: models, tools, cloud features, methods, use cases and AGI research.">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="headline text-4xl sm:text-6xl">Research Radar</h1>
      <p class="mt-3 max-w-3xl text-ink-muted dark:text-[#a1a1a6]">
        Every new GenAI development from the last {RADAR_DAYS} days, from all 30 sources: models, tools, cloud features, methods, use cases and AGI research.
        Rows marked <span class="font-semibold text-emerald-600 dark:text-emerald-400">✓</span> were read and written up by the AI agents; the rest are tagged automatically.
      </p>
      <p class="mt-2 text-sm text-ink-muted dark:text-[#a1a1a6]">
        Source Type: <b>Directed</b> = official labs, research and cloud sources · <b>Emergent</b> = Hacker News, Reddit, YouTube, newsletters · <b>AI-assisted</b> = found by the agents' web search.
      </p>
    </div>
    <a href={href("research-radar.csv")} download class="glass-button">Download CSV</a>
  </div>

  {entries.length === 0 ? (
    <div class="card mt-10 px-8 py-16 text-center">
      <p class="text-lg font-semibold">Nothing collected in the last {RADAR_DAYS} days yet</p>
      <p class="mt-2 text-ink-muted dark:text-[#a1a1a6]">The next 3-hourly run will fill this page.</p>
    </div>
  ) : (
    <div class="card mt-8 overflow-x-auto">
      <table class="w-full min-w-[1150px] text-left text-sm">
        <thead class="border-b border-slate-200 text-xs uppercase tracking-wide text-ink-muted dark:border-white/10 dark:text-[#a1a1a6]">
          <tr>{LOG_COLUMNS.map((c) => <th class="whitespace-nowrap px-4 py-3">{c}</th>)}</tr>
        </thead>
        <tbody class="divide-y divide-slate-200/70 align-top dark:divide-white/10">
          {entries.map(({ row, reviewed: byAgents }) => (
            <tr>
              {row.map((cell, i) =>
                i === linkIndex ? (
                  <td class="px-4 py-3"><a href={cell} target="_blank" rel="noopener" class="font-medium text-brand-600 hover:underline dark:text-brand-400">Open ↗</a></td>
                ) : i === topicIndex ? (
                  <td class="min-w-[220px] px-4 py-3 font-semibold">
                    {byAgents && <span class="mr-1 text-emerald-600 dark:text-emerald-400" title="Read and written up by the AI agents">✓</span>}
                    {cell}
                  </td>
                ) : (
                  <td class={`px-4 py-3 ${i === summaryIndex ? "min-w-[320px] text-ink-muted dark:text-[#a1a1a6]" : "whitespace-nowrap"}`}>{cell}</td>
                ),
              )}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
  <p class="mt-4 text-sm text-ink-muted dark:text-[#a1a1a6]">
    {entries.length} rows ({reviewed} reviewed by the AI agents) · refreshed every 3 hours
  </p>
</BaseLayout>
