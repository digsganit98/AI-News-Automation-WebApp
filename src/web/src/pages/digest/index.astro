---
// The latest daily edition (a deck of short opinion takes), or a note that the first one is on its way.
import DigestView from "../../components/DigestView.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { digestCards, formatDay, href, loadDigests } from "../../lib/siteData";

const editions = loadDigests();
const latest = editions[0];
---

<BaseLayout title="Daily digest" current="digest" description="Today's briefing: three short AI-written takes on what's happening in GenAI, fact-checked against the sources.">
  {latest ? (
    <div class="edition-scale">
      <DigestView edition={latest} />
      {editions.length > 1 && (
        <section class="mx-auto mt-16 max-w-3xl">
          <h2 class="mb-4 text-2xl font-semibold">Earlier briefings</h2>
          <div class="grid gap-3">
            {editions.slice(1, 13).map((e) => (
              <a href={href(`digest/${e.date}`)} class="card block p-5 transition hover:-translate-y-0.5">
                <p class="eyebrow !text-[11px]">{formatDay(e.date)}</p>
                <ul class="mt-2 space-y-1">
                  {digestCards(e).map((card) => (
                    <li class="flex gap-2 leading-snug"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-brand-500"></span><span class="font-medium">{card.title}</span></li>
                  ))}
                </ul>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  ) : (
    <section class="card mx-auto max-w-2xl px-8 py-16 text-center">
      <p class="eyebrow mb-3">Daily edition</p>
      <h1 class="headline text-4xl sm:text-5xl">The first briefing is on its way.</h1>
      <p class="mt-4 text-lg text-ink-muted dark:text-[#a1a1a6]">
        Every morning, by 09:30 IST, the Writer agent turns the day's stories into three short opinion takes, and the Editor agent fact-checks them. It will appear here.
      </p>
      <a href={href("")} class="glass-button mt-8">See the latest news</a>
    </section>
  )}
</BaseLayout>
