---
import BaseLayout from "../layouts/BaseLayout.astro";
import RndIdeaHub from "../components/RndIdeaHub";
import ideasData from "../data/rndIdeas.json";
import type { RndIdea } from "../lib/rndTypes";

const ideas = ideasData as RndIdea[];
---

<BaseLayout
  title="R&D Ideas"
  current="ideas"
  description="Curated AI concepts, frameworks, and architectures for builders."
  showFooter
>
  <div class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">R&D Ideas</h1>
    <p class="mt-1 text-xs text-slate-600 sm:text-sm">
      Curated AI concepts, frameworks, and architectures for builders.
    </p>
  </div>

  <RndIdeaHub client:load initialIdeas={ideas} />
</BaseLayout>

