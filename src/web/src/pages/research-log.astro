---
// Research log: one row per story, in the research strategy's exact columns, with a CSV download.
import BaseLayout from "../layouts/BaseLayout.astro";
import { LOG_COLUMNS, href, loadLogStories, logRow } from "../lib/siteData";

const stories = loadLogStories(7);
const rows = stories.map(logRow);
const linkIndex = LOG_COLUMNS.indexOf("Link");
const summaryIndex = LOG_COLUMNS.indexOf("Summary");
---

<BaseLayout title="Research log" current="log" description="Every GenAI development the agents found, as a research log you can download.">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="headline text-4xl sm:text-6xl">Research log</h1>
      <p class="mt-3 max-w-2xl text-ink-muted dark:text-[#a1a1a6]">
        Every genuinely new GenAI development from the last 7 days, one row each. Source Type: <b>Directed</b> = official labs, research and cloud sources; <b>Emergent</b> = spotted on community platforms, video and newsletters; <b>AI-assisted</b> = found by the agents' own web search.
      </p>
    </div>
    <a href={href("research-log.csv")} download class="glass-button">Download CSV</a>
  </div>

  {rows.length === 0 ? (
    <div class="card mt-10 px-8 py-16 text-center">
      <p class="text-lg font-semibold">No stories yet</p>
      <p class="mt-2 text-ink-muted dark:text-[#a1a1a6]">The AI agents add rows every 3 hours once their API keys are set up.</p>
    </div>
  ) : (
    <div class="card mt-8 overflow-x-auto">
      <table class="w-full min-w-[1100px] text-left text-sm">
        <thead class="border-b border-slate-200 text-xs uppercase tracking-wide text-ink-muted dark:border-white/10 dark:text-[#a1a1a6]">
          <tr>{LOG_COLUMNS.map((c) => <th class="whitespace-nowrap px-4 py-3">{c}</th>)}</tr>
        </thead>
        <tbody class="divide-y divide-slate-200/70 align-top dark:divide-white/10">
          {rows.map((row) => (
            <tr>
              {row.map((cell, i) => (
                i === linkIndex ? (
                  <td class="px-4 py-3"><a href={cell} target="_blank" rel="noopener" class="font-medium text-brand-600 hover:underline dark:text-brand-400">Open ↗</a></td>
                ) : (
                  <td class={`px-4 py-3 ${i === summaryIndex ? "min-w-[320px] text-ink-muted dark:text-[#a1a1a6]" : i === 2 ? "min-w-[220px] font-semibold" : "whitespace-nowrap"}`}>{cell}</td>
                )
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
  <p class="mt-4 text-sm text-ink-muted dark:text-[#a1a1a6]">{rows.length} rows · refreshed every 3 hours</p>
</BaseLayout>
