---
// Home: the Latest dashboard, refreshed by every 3-hourly run.
import NewsFeed from "../components/NewsFeed";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  GROUPS, formatDay, href, iconMap, loadDays, loadSources, sortNewestFirst, toFeedItem, toFeedSources,
} from "../lib/siteData";

const days = loadDays();
const sources = loadSources();
const latest = days[0];
// Today and yesterday, so the feed always covers at least the last 24 hours.
const items = sortNewestFirst(days.slice(0, 2).flatMap((d) => d.items)).map(toFeedItem);
const lastRun = latest?.runs.at(-1);
const healthy = lastRun?.health.filter((h) => h.ok).length ?? 0;
const tracked = lastRun?.health.length ?? sources.filter((s) => s.enabled).length;
const buildTime = new Date().toISOString();
---

<BaseLayout title="Latest" current="home">
  <section class="mb-12 text-center sm:text-left">
    <p class="glass mb-5 inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-semibold text-ink dark:text-white">
      <span class="relative flex size-2"><span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span></span>
      Live · updates every 3 hours
    </p>
    <h1 class="headline text-5xl leading-[1.05] sm:text-7xl">Today in<br />Generative AI.</h1>
    <p class="mt-5 max-w-2xl text-xl leading-relaxed text-ink-muted dark:text-[#a1a1a6]">
      News from AI labs, research, community forums, YouTube and newsletters, collected automatically every 3 hours.
    </p>
    {latest && <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">{formatDay(latest.date)}</p>}
  </section>

  <section class="mb-8 grid grid-cols-2 gap-3 lg:grid-cols-4" aria-label="At a glance">
    <div class="card p-5">
      <p class="eyebrow !text-[11px]">Items today</p>
      <p class="mt-1 text-4xl font-semibold tracking-[-0.03em]">{latest?.items.length ?? 0}</p>
      <p class="text-xs text-slate-500 dark:text-slate-400">{latest?.runs.length ?? 0} collection {(latest?.runs.length ?? 0) === 1 ? "run" : "runs"}</p>
    </div>
    <div class="card p-5">
      <p class="eyebrow !text-[11px]">Sources live</p>
      <p class="mt-1 text-4xl font-semibold tracking-[-0.03em]">{healthy}<span class="text-lg font-semibold text-slate-400">/{tracked}</span></p>
      <a class="text-xs text-brand-600 hover:underline dark:text-brand-400" href={href("sources")}>Source health →</a>
    </div>
    <div class="card p-5">
      <p class="eyebrow !text-[11px]">Last update</p>
      <p class="mt-1 text-4xl font-semibold tracking-[-0.03em]" data-relative={latest?.updatedAt ?? ""}>–</p>
      <p class="text-xs text-slate-500 dark:text-slate-400" data-local-time={latest?.updatedAt ?? ""}></p>
    </div>
    <div class="card p-5">
      <p class="eyebrow !text-[11px]">Next update</p>
      <p class="mt-1 text-4xl font-semibold tracking-[-0.03em]" id="nextUpdate">–</p>
      <p class="text-xs text-slate-500 dark:text-slate-400">digest + op-ed daily at 10:00 IST</p>
    </div>
  </section>

  <section class="card relative mb-10 overflow-hidden p-6 sm:p-8">
    <div class="absolute -right-16 -top-16 size-64 rounded-full bg-gradient-to-br from-brand-400/30 to-violet-glow/30 blur-3xl"></div>
    <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="eyebrow mb-2 !text-[#bf5af2]">Coming next</p>
        <h2 class="text-2xl font-semibold sm:text-3xl">Daily digest &amp; op-ed</h2>
        <p class="mt-2 max-w-2xl text-slate-600 dark:text-slate-400">
          Seven AI agents will read today's news, keep what matters, and write a daily digest plus a short op-ed at 10:00 IST, with every claim checked against its sources.
          Until they launch, the feed below shows everything collected.
        </p>
      </div>
      <a href={href("about")} class="glass-button shrink-0">How it works</a>
    </div>
  </section>

  <h2 class="mb-5 text-3xl font-semibold">Latest news</h2>
  {items.length > 0 ? (
    <NewsFeed client:load items={items} sources={toFeedSources(sources)} icons={iconMap(sources)} groups={GROUPS} buildTime={buildTime} live />
  ) : (
    <div class="card px-6 py-16 text-center">
      <p class="text-lg font-semibold">No news collected yet</p>
      <p class="mt-2 text-slate-500">The first scheduled run will fill this page within 3 hours.</p>
    </div>
  )}

  <script is:inline>
    // Relative "last update" time and a countdown to the next scheduled run.
    // Runs are at 01:30, 04:30, ... 22:30 UTC (every 3 hours), i.e. 07:00, 10:00, ... IST.
    const rel = (t) => {
      const m = Math.round((Date.now() - new Date(t).getTime()) / 60000);
      return m < 1 ? "just now" : m < 60 ? `${m} min ago` : m < 1440 ? `${Math.floor(m / 60)} h ago` : `${Math.floor(m / 1440)} d ago`;
    };
    const tick = () => {
      document.querySelectorAll("[data-relative]").forEach((el) => { if (el.dataset.relative) el.textContent = rel(el.dataset.relative); });
      const now = new Date();
      const next = new Date(now);
      next.setUTCMinutes(30, 0, 0);
      while (next <= now || (next.getUTCHours() - 1) % 3 !== 0) next.setUTCHours(next.getUTCHours() + 1);
      const mins = Math.round((next - now) / 60000);
      const el = document.getElementById("nextUpdate");
      if (el) el.textContent = mins >= 60 ? `${Math.floor(mins / 60)} h ${mins % 60} m` : `${mins} min`;
    };
    document.querySelectorAll("[data-local-time]").forEach((el) => {
      if (el.dataset.localTime) el.textContent = new Date(el.dataset.localTime).toLocaleString(undefined, { dateStyle: "medium", timeStyle: "short" });
    });
    tick();
    setInterval(tick, 30000);
  </script>
</BaseLayout>
