---
// Home: the Latest dashboard, refreshed by every 3-hourly run.
import NewsFeed from "../components/NewsFeed";
import StoryCard from "../components/StoryCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  GROUPS, formatDay, href, iconMap, loadDays, loadDigests, loadSources, loadTopStories, sortNewestFirst,
  toFeedItem, toFeedSources,
} from "../lib/siteData";

const days = loadDays();
const sources = loadSources();
const latest = days[0];
// Today and yesterday, so the feed always covers at least the last 24 hours.
const items = sortNewestFirst(days.slice(0, 2).flatMap((d) => d.items)).map(toFeedItem);
const buildTime = new Date().toISOString();
const edition = loadDigests()[0];
// The analyst's stories from today and yesterday, most important first.
const topStories = loadTopStories(2).slice(0, 9);
---

<BaseLayout title="Latest" current="home">
  <section class="mb-12 flex flex-col gap-8 lg:flex-row lg:items-start lg:justify-between">
   <div class="text-center sm:text-left">
    <p class="glass mb-5 inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-semibold text-ink dark:text-white">
      <span class="relative flex size-2"><span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span></span>
      Live · updates every 3 hours
    </p>
    <h1 class="headline text-5xl leading-[1.05] sm:text-7xl">Today in<br />Generative AI.</h1>
    <p class="mt-5 max-w-2xl text-xl leading-relaxed text-ink-muted dark:text-[#a1a1a6]">
      New models, tools, cloud features, research and real-world uses: from AI labs, cloud platforms, papers, Hacker News, YouTube and newsletters, every 3 hours.
    </p>
    {latest && <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">{formatDay(latest.date)}</p>}
   </div>

   <aside class="flex shrink-0 justify-center gap-2.5 lg:mt-2 lg:flex-col lg:items-stretch" aria-label="At a glance">
    <div class="card min-w-[150px] px-4 py-3">
      <p class="eyebrow !text-[10px]">Items today</p>
      <p class="text-2xl font-semibold tracking-[-0.03em]">{latest?.items.length ?? 0}</p>
      <p class="text-[11px] text-slate-500 dark:text-slate-400">{latest?.runs.length ?? 0} collection {(latest?.runs.length ?? 0) === 1 ? "run" : "runs"}</p>
    </div>
    <div class="card min-w-[150px] px-4 py-3">
      <p class="eyebrow !text-[10px]">Last update</p>
      <p class="text-2xl font-semibold tracking-[-0.03em]" data-relative={latest?.updatedAt ?? ""}>–</p>
      <p class="text-[11px] text-slate-500 dark:text-slate-400" data-local-time={latest?.updatedAt ?? ""}></p>
    </div>
   </aside>
  </section>

  <section class="card relative mb-12 overflow-hidden p-6 sm:p-8">
    <div class="absolute -right-16 -top-16 size-64 rounded-full bg-gradient-to-br from-brand-400/30 to-violet-glow/30 blur-3xl"></div>
    {edition ? (
      <div class="relative grid gap-6 lg:grid-cols-[1.4fr_1fr]">
        <div>
          <p class="eyebrow mb-2">Daily digest · {formatDay(edition.date)}</p>
          <h2 class="text-2xl font-semibold leading-tight tracking-[-0.03em] sm:text-4xl">{edition.digest.headline}</h2>
          <p class="mt-3 text-lg text-ink-muted dark:text-[#a1a1a6]">{edition.digest.dek}</p>
          <ul class="mt-5 space-y-2.5">
            {edition.digest.tldr.map((line) => (
              <li class="flex gap-3 leading-snug"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-brand-500"></span>{line}</li>
            ))}
          </ul>
          <a href={href(`digest/${edition.date}`)} class="glass-button mt-6">Read the full digest</a>
        </div>
        <a href={href(`digest/${edition.date}#op-ed`)} class="glass group flex flex-col justify-between rounded-3xl p-6">
          <div>
            <p class="eyebrow mb-2 !text-[#bf5af2]">Today's op-ed</p>
            <p class="text-xl font-semibold leading-snug tracking-[-0.02em] group-hover:text-brand-600 dark:group-hover:text-brand-400">{edition.opEd.title}</p>
            <p class="mt-2 text-sm text-ink-muted dark:text-[#a1a1a6]">{edition.opEd.dek}</p>
          </div>
          <p class="mt-4 text-sm font-semibold text-brand-600 dark:text-brand-400">Read the op-ed →</p>
        </a>
      </div>
    ) : (
      <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="eyebrow mb-2 !text-[#bf5af2]">Daily digest &amp; op-ed</p>
          <h2 class="text-2xl font-semibold sm:text-3xl">The first edition arrives at 10:00 IST</h2>
          <p class="mt-2 max-w-2xl text-ink-muted dark:text-[#a1a1a6]">
            Every morning the Writer agent turns the day's top stories into a digest and a short op-ed, and the Editor agent checks every claim against the sources.
          </p>
        </div>
        <a href={href("about")} class="glass-button shrink-0">How it works</a>
      </div>
    )}
  </section>

  {topStories.length > 0 && (
    <section class="mb-14">
      <div class="mb-5 flex flex-wrap items-end justify-between gap-2">
        <h2 class="text-3xl font-semibold">Top stories</h2>
        <p class="text-sm text-ink-muted dark:text-[#a1a1a6]">Picked, grouped and ranked by the AI agents</p>
      </div>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {topStories.map((story) => <StoryCard story={story} />)}
      </div>
    </section>
  )}

  <h2 class="mb-5 text-3xl font-semibold">{topStories.length > 0 ? "Everything collected" : "Latest news"}</h2>
  {items.length > 0 ? (
    <NewsFeed client:load items={items} sources={toFeedSources(sources)} icons={iconMap(sources)} groups={GROUPS} buildTime={buildTime} live />
  ) : (
    <div class="card px-6 py-16 text-center">
      <p class="text-lg font-semibold">No news collected yet</p>
      <p class="mt-2 text-slate-500">The first scheduled run will fill this page within 3 hours.</p>
    </div>
  )}

  <script is:inline>
    // Relative "last update" time, kept fresh while the page is open.
    const rel = (t) => {
      const m = Math.round((Date.now() - new Date(t).getTime()) / 60000);
      return m < 1 ? "just now" : m < 60 ? `${m} min ago` : m < 1440 ? `${Math.floor(m / 60)} h ago` : `${Math.floor(m / 1440)} d ago`;
    };
    const tick = () => {
      document.querySelectorAll("[data-relative]").forEach((el) => { if (el.dataset.relative) el.textContent = rel(el.dataset.relative); });
    };
    document.querySelectorAll("[data-local-time]").forEach((el) => {
      if (el.dataset.localTime) el.textContent = new Date(el.dataset.localTime).toLocaleString(undefined, { dateStyle: "medium", timeStyle: "short" });
    });
    tick();
    setInterval(tick, 30000);
  </script>
</BaseLayout>
