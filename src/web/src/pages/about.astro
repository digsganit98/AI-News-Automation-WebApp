---
// How it works: schedule, architecture, agents and LLM usage.
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import { projectUrl, repoRoot } from "../lib/siteData";

const architectureSvg = fs.readFileSync(path.join(repoRoot, "docs", "images", "architecture.svg"), "utf8");

const agents = [
  { name: "Scout · Labs & research", when: "every 3 h", llm: "Qwen 3.8 27B · Groq", job: "Checks the AI labs and Hugging Face; reads the full article for important items." },
  { name: "Scout · Cloud & platforms", when: "every 3 h", llm: "Qwen 3.8 27B · Groq", job: "Checks AWS, Azure and Google Cloud for new GenAI products and features." },
  { name: "Scout · Community", when: "every 3 h", llm: "Qwen 3.8 27B · Groq", job: "Checks Hacker News for launches and discussions." },
  { name: "Scout · Video, newsletters & blogs", when: "every 3 h", llm: "Qwen 3.8 27B · Groq", job: "Checks YouTube (news only, not tutorials), Substack, Medium and newsletter emails." },
  { name: "Scout · X", when: "every 3 h", llm: "Qwen 3.8 27B · Groq", job: "Checks posts from curated AI researchers and founders." },
  { name: "Scout · Web search", when: "every 3 h", llm: "Qwen 3.8 27B · Groq", job: "Searches the web (LinkedIn, X, YC, labs without feeds, Coimbatore) for fresh GenAI news." },
  { name: "Analyst", when: "every 3 h", llm: "gpt-oss-120b · Groq", job: "Scores, categorizes and groups stories; compares with the last 7 days." },
  { name: "Writer", when: "by 09:30 IST", llm: "Gemini Flash", job: "Writes the daily digest and a ~600-word op-ed." },
  { name: "Editor", when: "by 09:30 IST", llm: "gpt-oss-120b · Groq", job: "Fact-checks every claim against the sources; one revision round." },
];
const stats = [
  { value: "30", label: "sources" },
  { value: "9", label: "AI agents" },
  { value: "~80–100", label: "LLM calls a day" },
  { value: "150", label: "daily call cap" },
  { value: "8×", label: "updates a day" },
  { value: "$0", label: "running cost" },
];
---

<BaseLayout title="How it works" current="about" description="How GenAI Daily collects, filters and writes up the news.">
  <h1 class="headline text-4xl sm:text-6xl">How it works</h1>
  <p class="mt-3 max-w-3xl text-lg text-ink-muted dark:text-[#a1a1a6]">
    Every 3 hours a GitHub Actions job collects new posts from 30 sources, removes anything seen before, and updates this site.
    Every morning, on the site by 09:30 IST, AI agents write a digest and an op-ed and send one email.
  </p>

  <section class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
    {stats.map((s) => (
      <div class="card p-4 text-center">
        <p class="text-2xl font-bold text-brand-600 dark:text-brand-400">{s.value}</p>
        <p class="text-xs text-slate-500 dark:text-slate-400">{s.label}</p>
      </div>
    ))}
  </section>

  <section class="mt-12">
    <h2 class="text-2xl font-semibold">Architecture</h2>
    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Green dot = working today, grey = coming next. Solid arrows run every 3 hours, dashed ones once each morning.</p>
    <div class="card mt-4 overflow-x-auto bg-white p-3 dark:bg-white">
      <div class="min-w-[900px] [&>svg]:h-auto [&>svg]:w-full" set:html={architectureSvg}></div>
    </div>
  </section>

  <section class="mt-12 grid gap-6 lg:grid-cols-2">
    <div class="card p-6">
      <h2 class="text-xl font-semibold">Every 3 hours</h2>
      <ol class="mt-3 list-decimal space-y-1.5 pl-5 text-ink-muted dark:text-[#a1a1a6]">
        <li>Collect new posts from every source</li>
        <li>Clean links and remove anything seen in the last 30 days</li>
        <li>Scout agents research the important items</li>
        <li>The analyst scores and groups stories</li>
        <li>This site is rebuilt with the latest news</li>
      </ol>
    </div>
    <div class="card p-6">
      <h2 class="text-xl font-semibold">Every morning, by 09:30 IST</h2>
      <ol class="mt-3 list-decimal space-y-1.5 pl-5 text-ink-muted dark:text-[#a1a1a6]">
        <li>Everything from the 3-hourly run</li>
        <li>The writer drafts the digest and an op-ed</li>
        <li>The editor checks each claim against the sources</li>
        <li>The digest and op-ed are published here</li>
        <li>One email goes to subscribers</li>
      </ol>
    </div>
  </section>

  <section class="mt-12">
    <h2 class="text-2xl font-semibold">The 9 AI agents</h2>
    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Built with LangGraph. The order they run in is fixed in code, so LLM usage stays predictable. Every call is traced in Langfuse.</p>
    <div class="card mt-4 overflow-x-auto">
      <table class="w-full min-w-[640px] text-left text-sm">
        <thead class="border-b border-slate-200 text-xs uppercase tracking-wide text-slate-500 dark:border-white/10 dark:text-slate-400">
          <tr><th class="px-5 py-3">Agent</th><th class="px-5 py-3">Runs</th><th class="px-5 py-3">LLM</th><th class="px-5 py-3">Job</th></tr>
        </thead>
        <tbody class="divide-y divide-slate-200/70 dark:divide-white/10">
          {agents.map((a) => (
            <tr>
              <td class="px-5 py-3 font-semibold">{a.name}</td>
              <td class="whitespace-nowrap px-5 py-3 text-ink-muted dark:text-[#a1a1a6]">{a.when}</td>
              <td class="whitespace-nowrap px-5 py-3"><span class="pill border-slate-200 dark:border-white/10">{a.llm}</span></td>
              <td class="px-5 py-3 text-ink-muted dark:text-[#a1a1a6]">{a.job}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">
      About 11 LLM calls per 3-hourly update and ~16 for the morning edition: roughly 80–100 a day, capped at 150. All on free tiers (Groq and Google Gemini).
    </p>
  </section>

  <section class="card mt-12 p-6">
    <h2 class="text-xl font-semibold">Open source</h2>
    <p class="mt-2 text-ink-muted dark:text-[#a1a1a6]">
      The code, setup guide and full architecture are on <a class="font-medium text-brand-600 underline-offset-4 hover:underline dark:text-brand-400" href={projectUrl} target="_blank" rel="noopener">GitHub</a>.
      You can run your own copy for free in about 10 minutes.
    </p>
  </section>
</BaseLayout>
