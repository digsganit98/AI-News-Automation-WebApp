# Copy this file to `.env` and fill in your own values. `.env` is ignored by git.
# On GitHub, add the same names as repository secrets instead
# (Settings -> Secrets and variables -> Actions).
#
# You can also override any value from config/app.env here, e.g. for local testing.

# Dedicated Gmail account that receives the newsletters and sends the digest
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional: fallback for when YouTube's RSS feed is down (free key from Google Cloud Console)
YOUTUBE_API_KEY=

# AI agents (Phase 2). Free keys, no credit card:
#   Groq:   https://console.groq.com/keys
#   Gemini: https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
